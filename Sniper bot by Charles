# -----------------------
# EMA helpers
# -----------------------
def calc_ema(prev_ema, price, period):
    alpha = 2.0 / (period + 1)
    if prev_ema is None:
        return price
    return (price - prev_ema) * alpha + prev_ema

# -----------------------
# Risk / stake sizing
# -----------------------
def compute_stake(balance):
    # stake percent of balance, round to 2 decimals, min 0.5
    stake = max(0.01, (CONFIG["stake_percent"] / 100.0) * balance)
    # Round to 2 decimal places typical for synthetic indices
    stake = round(stake, 2)
    return stake

